{
  "$defs": {
    "ReferenceContextIndexEntry": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Chunk Id",
          "type": "string"
        },
        "chapter_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Chapter Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "package_file": {
          "format": "path",
          "title": "Package File",
          "type": "string"
        },
        "package_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Sha256",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "chapter_id",
        "source_sha256",
        "package_file",
        "package_sha256"
      ],
      "title": "ReferenceContextIndexEntry",
      "type": "object"
    },
    "ReferenceCorpusIdentity": {
      "additionalProperties": false,
      "description": "The verified identity of one external corpus at retrieval time.",
      "properties": {
        "corpus_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Corpus Id",
          "type": "string"
        },
        "book_number": {
          "minimum": 1,
          "title": "Book Number",
          "type": "integer"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "corpus_version": {
          "minLength": 1,
          "title": "Corpus Version",
          "type": "string"
        },
        "freeze_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freeze Manifest Sha256"
        }
      },
      "required": [
        "corpus_id",
        "book_number",
        "label",
        "path",
        "sha256",
        "corpus_version"
      ],
      "title": "ReferenceCorpusIdentity",
      "type": "object"
    },
    "ReferenceRetrievalIdentity": {
      "additionalProperties": false,
      "properties": {
        "retriever_path": {
          "minLength": 1,
          "title": "Retriever Path",
          "type": "string"
        },
        "retriever_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Retriever Sha256",
          "type": "string"
        },
        "retriever_schema_version": {
          "minLength": 1,
          "title": "Retriever Schema Version",
          "type": "string"
        },
        "corpora": {
          "items": {
            "$ref": "#/$defs/ReferenceCorpusIdentity"
          },
          "minItems": 1,
          "title": "Corpora",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/ReferenceRetrievalLimits"
        },
        "include_uncertain": {
          "const": false,
          "default": false,
          "title": "Include Uncertain",
          "type": "boolean"
        },
        "include_reference_only": {
          "const": false,
          "default": false,
          "title": "Include Reference Only",
          "type": "boolean"
        }
      },
      "required": [
        "retriever_path",
        "retriever_sha256",
        "retriever_schema_version",
        "corpora",
        "limits"
      ],
      "title": "ReferenceRetrievalIdentity",
      "type": "object"
    },
    "ReferenceRetrievalLimits": {
      "additionalProperties": false,
      "properties": {
        "term_limit": {
          "default": 15,
          "minimum": 0,
          "title": "Term Limit",
          "type": "integer"
        },
        "entity_limit": {
          "default": 15,
          "minimum": 0,
          "title": "Entity Limit",
          "type": "integer"
        },
        "tm_limit": {
          "default": 8,
          "minimum": 0,
          "title": "Tm Limit",
          "type": "integer"
        },
        "phrase_limit": {
          "default": 6,
          "minimum": 0,
          "title": "Phrase Limit",
          "type": "integer"
        },
        "style_limit": {
          "default": 3,
          "minimum": 0,
          "title": "Style Limit",
          "type": "integer"
        },
        "voice_limit": {
          "default": 4,
          "minimum": 0,
          "title": "Voice Limit",
          "type": "integer"
        }
      },
      "title": "ReferenceRetrievalLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "index_kind": {
      "const": "reference_context_index",
      "default": "reference_context_index",
      "title": "Index Kind",
      "type": "string"
    },
    "contract_version": {
      "minLength": 1,
      "title": "Contract Version",
      "type": "string"
    },
    "book_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Book Id",
      "type": "string"
    },
    "retrieval": {
      "$ref": "#/$defs/ReferenceRetrievalIdentity"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ReferenceContextIndexEntry"
      },
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "book_id",
    "retrieval"
  ],
  "title": "ReferenceContextIndex",
  "type": "object"
}
