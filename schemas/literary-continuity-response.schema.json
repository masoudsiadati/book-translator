{
  "$defs": {
    "ContinuityFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ContinuityFindingCode"
        },
        "severity": {
          "enum": [
            "advisory",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "paragraph_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Paragraph Ids",
          "type": "array"
        },
        "observation": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "paragraph_ids",
        "observation"
      ],
      "title": "ContinuityFinding",
      "type": "object"
    },
    "ContinuityFindingCode": {
      "description": "Closed vocabulary for a read-only chapter continuity review.",
      "enum": [
        "unnatural_persian",
        "inconsistent_narrator_register",
        "inconsistent_character_voice",
        "dialogue_tone_inconsistency",
        "pronoun_reference_ambiguity",
        "repeated_translationese",
        "awkward_paragraph_transition",
        "terminology_inconsistency",
        "local_stylistic_discontinuity"
      ],
      "title": "ContinuityFindingCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Read-only output: there is structurally nowhere to return rewritten text.",
  "properties": {
    "schema_version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "continuity_schema_version": {
      "title": "Continuity Schema Version",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ContinuityFinding"
      },
      "maxItems": 100,
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "continuity_schema_version"
  ],
  "title": "ContinuityReviewResponse",
  "type": "object"
}
