{
  "$defs": {
    "TocEntry": {
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Entry Id",
          "type": "string"
        },
        "level": {
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/TocKind"
        },
        "number": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "title_en": {
          "default": "",
          "title": "Title En",
          "type": "string"
        },
        "title_fa": {
          "default": "",
          "title": "Title Fa",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "start_page": {
          "minimum": 1,
          "title": "Start Page",
          "type": "integer"
        },
        "end_page": {
          "minimum": 1,
          "title": "End Page",
          "type": "integer"
        },
        "source_toc_title": {
          "minLength": 1,
          "title": "Source Toc Title",
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "level",
        "kind",
        "start_page",
        "end_page",
        "source_toc_title"
      ],
      "title": "TocEntry",
      "type": "object"
    },
    "TocKind": {
      "enum": [
        "front_matter",
        "prologue",
        "chapter",
        "epilogue",
        "appendix",
        "unknown"
      ],
      "title": "TocKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Versioned normalized embedded TOC persisted as workspace/toc.yaml.",
  "properties": {
    "schema_version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "const": "embedded",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "source_pdf": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Pdf"
    },
    "source_pdf_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Pdf Sha256"
    },
    "pdf_page_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pdf Page Count"
    },
    "entry_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entry Count"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/TocEntry"
      },
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "entries"
  ],
  "title": "TocDocument",
  "type": "object"
}
