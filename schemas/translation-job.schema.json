{
  "$defs": {
    "QueueEvent": {
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Event Type",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "worker_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worker Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "event_type",
        "occurred_at"
      ],
      "title": "QueueEvent",
      "type": "object"
    },
    "SemanticGateStatus": {
      "description": "The governed semantic state of one job. Absent means not judged.",
      "enum": [
        "pass",
        "revise",
        "inconclusive",
        "unresolved"
      ],
      "title": "SemanticGateStatus",
      "type": "string"
    },
    "TranslationAcceptanceOrigin": {
      "enum": [
        "initial_qa",
        "qa_reevaluation",
        "reuse_qa",
        "historical_reevaluation",
        "structural_repair"
      ],
      "title": "TranslationAcceptanceOrigin",
      "type": "string"
    },
    "TranslationAcceptanceStatus": {
      "enum": [
        "accepted",
        "qa_rejected"
      ],
      "title": "TranslationAcceptanceStatus",
      "type": "string"
    },
    "TranslationJobStatus": {
      "enum": [
        "pending",
        "claimed",
        "running",
        "succeeded",
        "failed",
        "retry_pending",
        "cancelled",
        "blocked"
      ],
      "title": "TranslationJobStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*__[a-z0-9._-]+$",
      "title": "Job Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^tr-[0-9a-f]{12}-\\d{3,}$",
      "title": "Run Id",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "chapter_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Chapter Id",
      "type": "string"
    },
    "chapter_sequence": {
      "minimum": 1,
      "title": "Chapter Sequence",
      "type": "integer"
    },
    "chunk_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Chunk Id",
      "type": "string"
    },
    "chunk_sequence": {
      "minimum": 1,
      "title": "Chunk Sequence",
      "type": "integer"
    },
    "chunk_source_file": {
      "format": "path",
      "title": "Chunk Source File",
      "type": "string"
    },
    "chunk_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Chunk Source Sha256",
      "type": "string"
    },
    "context_file": {
      "format": "path",
      "title": "Context File",
      "type": "string"
    },
    "context_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Sha256",
      "type": "string"
    },
    "source_word_count": {
      "minimum": 0,
      "title": "Source Word Count",
      "type": "integer"
    },
    "context_word_count": {
      "minimum": 0,
      "title": "Context Word Count",
      "type": "integer"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "glossary_version": {
      "title": "Glossary Version",
      "type": "string"
    },
    "style_guide_version": {
      "title": "Style Guide Version",
      "type": "string"
    },
    "source_language": {
      "minLength": 2,
      "title": "Source Language",
      "type": "string"
    },
    "target_language": {
      "minLength": 2,
      "title": "Target Language",
      "type": "string"
    },
    "queue_version": {
      "title": "Queue Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TranslationJobStatus"
    },
    "priority": {
      "minimum": 1,
      "title": "Priority",
      "type": "integer"
    },
    "attempt_count": {
      "minimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "abandoned_attempt_count": {
      "default": 0,
      "minimum": 0,
      "title": "Abandoned Attempt Count",
      "type": "integer"
    },
    "max_attempts": {
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "next_retry_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Retry At"
    },
    "claimed_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claimed By"
    },
    "claim_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claim Token"
    },
    "claimed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claimed At"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "last_error_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error Category"
    },
    "last_error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error Message"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "last_attempt": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Attempt"
    },
    "successful_attempt": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Successful Attempt"
    },
    "acceptance_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/TranslationAcceptanceStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "accepted_attempt": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Attempt"
    },
    "acceptance_file": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acceptance File"
    },
    "acceptance_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acceptance Sha256"
    },
    "acceptance_origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/TranslationAcceptanceOrigin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reevaluation_count": {
      "default": 0,
      "minimum": 0,
      "title": "Reevaluation Count",
      "type": "integer"
    },
    "latest_reevaluation_file": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Reevaluation File"
    },
    "latest_reevaluation_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Reevaluation Sha256"
    },
    "reuse_count": {
      "default": 0,
      "minimum": 0,
      "title": "Reuse Count",
      "type": "integer"
    },
    "latest_reuse_file": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Reuse File"
    },
    "latest_reuse_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Reuse Sha256"
    },
    "carry_forward_count": {
      "default": 0,
      "minimum": 0,
      "title": "Carry Forward Count",
      "type": "integer"
    },
    "latest_carry_forward_file": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Carry Forward File"
    },
    "latest_carry_forward_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Carry Forward Sha256"
    },
    "structural_repair_count": {
      "default": 0,
      "minimum": 0,
      "title": "Structural Repair Count",
      "type": "integer"
    },
    "latest_structural_repair_file": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Structural Repair File"
    },
    "latest_structural_repair_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Structural Repair Sha256"
    },
    "semantic_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticGateStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "semantic_evidence_count": {
      "default": 0,
      "minimum": 0,
      "title": "Semantic Evidence Count",
      "type": "integer"
    },
    "latest_semantic_file": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Semantic File"
    },
    "latest_semantic_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Semantic Sha256"
    },
    "semantic_revision_count": {
      "default": 0,
      "minimum": 0,
      "title": "Semantic Revision Count",
      "type": "integer"
    },
    "latest_semantic_revision_file": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Semantic Revision File"
    },
    "latest_semantic_revision_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Semantic Revision Sha256"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "recent_events": {
      "items": {
        "$ref": "#/$defs/QueueEvent"
      },
      "maxItems": 20,
      "title": "Recent Events",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "run_id",
    "snapshot_id",
    "manifest_sha256",
    "chapter_id",
    "chapter_sequence",
    "chunk_id",
    "chunk_sequence",
    "chunk_source_file",
    "chunk_source_sha256",
    "context_file",
    "context_sha256",
    "source_word_count",
    "context_word_count",
    "prompt_version",
    "glossary_version",
    "style_guide_version",
    "source_language",
    "target_language",
    "queue_version",
    "status",
    "priority",
    "attempt_count",
    "max_attempts",
    "created_at",
    "updated_at"
  ],
  "title": "TranslationJob",
  "type": "object"
}
