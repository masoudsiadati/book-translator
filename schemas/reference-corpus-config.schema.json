{
  "$defs": {
    "ReferenceCorpusEntry": {
      "additionalProperties": false,
      "properties": {
        "corpus_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Corpus Id",
          "type": "string"
        },
        "book_number": {
          "minimum": 1,
          "title": "Book Number",
          "type": "integer"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "corpus_version": {
          "minLength": 1,
          "title": "Corpus Version",
          "type": "string"
        },
        "freeze_manifest_file": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freeze Manifest File"
        },
        "freeze_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freeze Manifest Sha256"
        }
      },
      "required": [
        "corpus_id",
        "book_number",
        "label",
        "path",
        "sha256",
        "corpus_version"
      ],
      "title": "ReferenceCorpusEntry",
      "type": "object"
    },
    "ReferenceRetrievalLimits": {
      "additionalProperties": false,
      "properties": {
        "term_limit": {
          "default": 15,
          "minimum": 0,
          "title": "Term Limit",
          "type": "integer"
        },
        "entity_limit": {
          "default": 15,
          "minimum": 0,
          "title": "Entity Limit",
          "type": "integer"
        },
        "tm_limit": {
          "default": 8,
          "minimum": 0,
          "title": "Tm Limit",
          "type": "integer"
        },
        "phrase_limit": {
          "default": 6,
          "minimum": 0,
          "title": "Phrase Limit",
          "type": "integer"
        },
        "style_limit": {
          "default": 3,
          "minimum": 0,
          "title": "Style Limit",
          "type": "integer"
        },
        "voice_limit": {
          "default": 4,
          "minimum": 0,
          "title": "Voice Limit",
          "type": "integer"
        }
      },
      "title": "ReferenceRetrievalLimits",
      "type": "object"
    },
    "ReferenceRetrieverReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "schema_version"
      ],
      "title": "ReferenceRetrieverReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "config_kind": {
      "const": "reference_corpus",
      "default": "reference_corpus",
      "title": "Config Kind",
      "type": "string"
    },
    "series_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Series Id",
      "type": "string"
    },
    "retriever": {
      "$ref": "#/$defs/ReferenceRetrieverReference"
    },
    "corpora": {
      "items": {
        "$ref": "#/$defs/ReferenceCorpusEntry"
      },
      "minItems": 1,
      "title": "Corpora",
      "type": "array"
    },
    "excluded_paths": {
      "items": {
        "format": "path",
        "type": "string"
      },
      "title": "Excluded Paths",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/ReferenceRetrievalLimits"
    },
    "include_uncertain": {
      "const": false,
      "default": false,
      "title": "Include Uncertain",
      "type": "boolean"
    },
    "include_reference_only": {
      "const": false,
      "default": false,
      "title": "Include Reference Only",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "series_id",
    "retriever",
    "corpora"
  ],
  "title": "ReferenceCorpusConfig",
  "type": "object"
}
