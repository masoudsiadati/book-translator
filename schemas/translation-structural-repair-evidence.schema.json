{
  "$defs": {
    "ParagraphAlignmentFinding": {
      "additionalProperties": false,
      "description": "One alignment or marker-contract defect, recorded without any translated content.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_paragraph_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Paragraph Index"
        },
        "related_paragraph_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Paragraph Index"
        },
        "expected_marker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Marker"
        },
        "observed_marker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Marker"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "ParagraphAlignmentFinding",
      "type": "object"
    },
    "StructuralDefectClass": {
      "description": "Why a source and its translation disagree about block structure.",
      "enum": [
        "none",
        "blank_line_geometry",
        "translation_line_split",
        "translation_line_merge",
        "line_count_divergence",
        "content_divergence"
      ],
      "title": "StructuralDefectClass",
      "type": "string"
    },
    "StructuralOperationKind": {
      "description": "What one aligned group of lines says happened to the source lines it covers.",
      "enum": [
        "aligned",
        "join_translation_lines",
        "split_translation_line"
      ],
      "title": "StructuralOperationKind",
      "type": "string"
    },
    "StructuralOperationRecord": {
      "additionalProperties": false,
      "description": "One non-identity correspondence, named precisely enough to re-derive by hand.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/StructuralOperationKind"
        },
        "source_index": {
          "minimum": 0,
          "title": "Source Index",
          "type": "integer"
        },
        "source_lines": {
          "minimum": 1,
          "title": "Source Lines",
          "type": "integer"
        },
        "translation_index": {
          "minimum": 0,
          "title": "Translation Index",
          "type": "integer"
        },
        "translation_lines": {
          "minimum": 1,
          "title": "Translation Lines",
          "type": "integer"
        },
        "cost_milli": {
          "minimum": 0,
          "title": "Cost Milli",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "source_index",
        "source_lines",
        "translation_index",
        "translation_lines",
        "cost_milli"
      ],
      "title": "StructuralOperationRecord",
      "type": "object"
    },
    "StructuralRepairDiagnosis": {
      "additionalProperties": false,
      "description": "The complete structural answer for one translation, before anything is changed.\n\nCosts and margins are recorded in thousandths as integers rather than as floats, because a\npersisted contract that has to round-trip byte-for-byte cannot depend on float formatting.",
      "properties": {
        "structural_repair_engine_version": {
          "minLength": 1,
          "title": "Structural Repair Engine Version",
          "type": "string"
        },
        "defect_class": {
          "$ref": "#/$defs/StructuralDefectClass"
        },
        "source_paragraphs": {
          "minimum": 0,
          "title": "Source Paragraphs",
          "type": "integer"
        },
        "translation_paragraphs": {
          "minimum": 0,
          "title": "Translation Paragraphs",
          "type": "integer"
        },
        "paragraph_delta": {
          "title": "Paragraph Delta",
          "type": "integer"
        },
        "source_lines": {
          "minimum": 0,
          "title": "Source Lines",
          "type": "integer"
        },
        "translation_lines": {
          "minimum": 0,
          "title": "Translation Lines",
          "type": "integer"
        },
        "line_delta": {
          "title": "Line Delta",
          "type": "integer"
        },
        "blank_line_artifact": {
          "title": "Blank Line Artifact",
          "type": "boolean"
        },
        "deterministic": {
          "title": "Deterministic",
          "type": "boolean"
        },
        "alignment_cost_milli": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alignment Cost Milli"
        },
        "alignment_margin_milli": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alignment Margin Milli"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/StructuralOperationRecord"
          },
          "title": "Operations",
          "type": "array"
        },
        "refusals": {
          "items": {
            "type": "string"
          },
          "title": "Refusals",
          "type": "array"
        }
      },
      "required": [
        "structural_repair_engine_version",
        "defect_class",
        "source_paragraphs",
        "translation_paragraphs",
        "paragraph_delta",
        "source_lines",
        "translation_lines",
        "line_delta",
        "blank_line_artifact",
        "deterministic"
      ],
      "title": "StructuralRepairDiagnosis",
      "type": "object"
    },
    "TerminologyEnforcement": {
      "description": "What kind of target evidence proves a canonical decision was honored.\n\n``required`` answers whether a decision is in scope for QA at all; this answers the separate\nquestion of what counts as proof.  Collapsing the two forces every approved decision into\n\"the exact canonical string must appear\", which is correct for a name and wrong for a form the\ntarget language legitimately transforms.",
      "enum": [
        "exact",
        "morphological",
        "contextual",
        "advisory"
      ],
      "title": "TerminologyEnforcement",
      "type": "string"
    },
    "TerminologyFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "source_term": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Term"
        },
        "enforcement": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminologyEnforcement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "TerminologyFinding",
      "type": "object"
    },
    "TerminologyValidationReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "translation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Translation Sha256",
          "type": "string"
        },
        "checked_decisions": {
          "minimum": 0,
          "title": "Checked Decisions",
          "type": "integer"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/TerminologyFinding"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "valid",
        "source_sha256",
        "translation_sha256",
        "checked_decisions"
      ],
      "title": "TerminologyValidationReport",
      "type": "object"
    },
    "TranslationAcceptanceOrigin": {
      "enum": [
        "initial_qa",
        "qa_reevaluation",
        "reuse_qa",
        "historical_reevaluation",
        "structural_repair"
      ],
      "title": "TranslationAcceptanceOrigin",
      "type": "string"
    },
    "TranslationAcceptanceStatus": {
      "enum": [
        "accepted",
        "qa_rejected"
      ],
      "title": "TranslationAcceptanceStatus",
      "type": "string"
    },
    "TranslationAlignmentReport": {
      "additionalProperties": false,
      "description": "The alignment verdict for one translated chunk.\n\n``contract_mode`` records how the paragraph identities being judged were established, because\nthe same measurements mean different things under the two.  Under ``marked`` a provider\nreturned the identities it was given and the measurements are a residual check; under\n``legacy_positional`` the identities are inferred from block order, which is exactly the\nassumption a boundary defect breaks, so the measurements are the only evidence there is.",
      "properties": {
        "schema_version": {
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "alignment_qa_version": {
          "title": "Alignment Qa Version",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "contract_mode": {
          "enum": [
            "marked",
            "legacy_positional"
          ],
          "title": "Contract Mode",
          "type": "string"
        },
        "marker_contract_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker Contract Version"
        },
        "evaluated": {
          "title": "Evaluated",
          "type": "boolean"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "translation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Translation Sha256",
          "type": "string"
        },
        "aligned_pairs": {
          "minimum": 0,
          "title": "Aligned Pairs",
          "type": "integer"
        },
        "measured_pairs": {
          "minimum": 0,
          "title": "Measured Pairs",
          "type": "integer"
        },
        "flagged_pairs": {
          "minimum": 0,
          "title": "Flagged Pairs",
          "type": "integer"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ParagraphAlignmentFinding"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "alignment_qa_version",
        "policy_id",
        "policy_version",
        "contract_mode",
        "evaluated",
        "valid",
        "source_sha256",
        "translation_sha256",
        "aligned_pairs",
        "measured_pairs",
        "flagged_pairs"
      ],
      "title": "TranslationAlignmentReport",
      "type": "object"
    },
    "TranslationQAFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "TranslationQAFinding",
      "type": "object"
    },
    "TranslationQAReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "translation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Translation Sha256",
          "type": "string"
        },
        "source_paragraph_count": {
          "minimum": 0,
          "title": "Source Paragraph Count",
          "type": "integer"
        },
        "translation_paragraph_count": {
          "minimum": 0,
          "title": "Translation Paragraph Count",
          "type": "integer"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/TranslationQAFinding"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "valid",
        "source_sha256",
        "translation_sha256",
        "source_paragraph_count",
        "translation_paragraph_count"
      ],
      "title": "TranslationQAReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable provenance for one adopted provider-free structural repair.\n\nThe field names deliberately match the acceptance and re-evaluation sidecars, because this\nrecord takes their place as one job's effective mechanical verdict and every reader that\nresolves an effective rejection has to be able to read all three the same way.",
  "properties": {
    "schema_version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "structural_repair_engine_version": {
      "minLength": 1,
      "title": "Structural Repair Engine Version",
      "type": "string"
    },
    "terminology_qa_version": {
      "minLength": 1,
      "title": "Terminology Qa Version",
      "type": "string"
    },
    "structural_qa_version": {
      "minLength": 1,
      "title": "Structural Qa Version",
      "type": "string"
    },
    "alignment_qa_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alignment Qa Version"
    },
    "run_id": {
      "pattern": "^tr-[0-9a-f]{12}-\\d{3,}$",
      "title": "Run Id",
      "type": "string"
    },
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "repair_number": {
      "minimum": 1,
      "title": "Repair Number",
      "type": "integer"
    },
    "provider_contacted": {
      "const": false,
      "default": false,
      "title": "Provider Contacted",
      "type": "boolean"
    },
    "content_preserved": {
      "const": true,
      "default": true,
      "title": "Content Preserved",
      "type": "boolean"
    },
    "superseded_evidence_file": {
      "format": "path",
      "title": "Superseded Evidence File",
      "type": "string"
    },
    "superseded_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Superseded Evidence Sha256",
      "type": "string"
    },
    "superseded_origin": {
      "$ref": "#/$defs/TranslationAcceptanceOrigin"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_number": {
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "attempt_file": {
      "format": "path",
      "title": "Attempt File",
      "type": "string"
    },
    "attempt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Attempt Sha256",
      "type": "string"
    },
    "source_file": {
      "format": "path",
      "title": "Source File",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "original_translation_file": {
      "format": "path",
      "title": "Original Translation File",
      "type": "string"
    },
    "original_translation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Original Translation Sha256",
      "type": "string"
    },
    "translation_file": {
      "format": "path",
      "title": "Translation File",
      "type": "string"
    },
    "translation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Translation Sha256",
      "type": "string"
    },
    "terminology_file": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terminology File"
    },
    "terminology_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terminology Sha256"
    },
    "diagnosis": {
      "$ref": "#/$defs/StructuralRepairDiagnosis"
    },
    "superseded_blocking_codes": {
      "items": {
        "type": "string"
      },
      "title": "Superseded Blocking Codes",
      "type": "array"
    },
    "terminology_report": {
      "$ref": "#/$defs/TerminologyValidationReport"
    },
    "structural_report": {
      "$ref": "#/$defs/TranslationQAReport"
    },
    "alignment_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/TranslationAlignmentReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "previous_status": {
      "$ref": "#/$defs/TranslationAcceptanceStatus"
    },
    "resulting_status": {
      "$ref": "#/$defs/TranslationAcceptanceStatus"
    },
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "origin": {
      "const": "structural_repair",
      "default": "structural_repair",
      "title": "Origin",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "structural_repair_engine_version",
    "terminology_qa_version",
    "structural_qa_version",
    "run_id",
    "job_id",
    "repair_number",
    "superseded_evidence_file",
    "superseded_evidence_sha256",
    "superseded_origin",
    "attempt_id",
    "attempt_number",
    "attempt_file",
    "attempt_sha256",
    "source_file",
    "source_sha256",
    "original_translation_file",
    "original_translation_sha256",
    "translation_file",
    "translation_sha256",
    "diagnosis",
    "terminology_report",
    "structural_report",
    "previous_status",
    "resulting_status",
    "accepted",
    "created_at"
  ],
  "title": "TranslationStructuralRepairEvidence",
  "type": "object"
}
