{
  "$defs": {
    "TerminologyDiscoveryEvidence": {
      "additionalProperties": false,
      "properties": {
        "source_term": {
          "minLength": 1,
          "title": "Source Term",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "classification": {
          "$ref": "#/$defs/TerminologyType"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "context_sensitive": {
          "default": false,
          "title": "Context Sensitive",
          "type": "boolean"
        },
        "occurrences": {
          "items": {
            "$ref": "#/$defs/TerminologyOccurrence"
          },
          "title": "Occurrences",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "source_term",
        "classification",
        "confidence",
        "reason"
      ],
      "title": "TerminologyDiscoveryEvidence",
      "type": "object"
    },
    "TerminologyOccurrence": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Chapter Id",
          "type": "string"
        },
        "chunk_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "location": {
          "default": "source",
          "enum": [
            "source",
            "context"
          ],
          "title": "Location",
          "type": "string"
        },
        "count": {
          "default": 1,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "chapter_id"
      ],
      "title": "TerminologyOccurrence",
      "type": "object"
    },
    "TerminologyType": {
      "enum": [
        "person",
        "place",
        "organization",
        "title",
        "people",
        "invented",
        "artifact",
        "historical_event",
        "story_term",
        "recurring_phrase",
        "context_sensitive"
      ],
      "title": "TerminologyType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/TerminologyDiscoveryEvidence"
      },
      "title": "Candidates",
      "type": "array"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "TerminologyDiscoveryResponse",
  "type": "object"
}
