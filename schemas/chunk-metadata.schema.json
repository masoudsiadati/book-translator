{
  "$defs": {
    "ChunkStatus": {
      "enum": [
        "pending",
        "translating",
        "translated",
        "validation_failed",
        "review_required",
        "reviewed",
        "approved",
        "failed"
      ],
      "title": "ChunkStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "chunk_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Chunk Id",
      "type": "string"
    },
    "chapter_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Chapter Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "source_file": {
      "format": "path",
      "title": "Source File",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "context_file": {
      "format": "path",
      "title": "Context File",
      "type": "string"
    },
    "context_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Sha256"
    },
    "context_word_count": {
      "default": 0,
      "minimum": 0,
      "title": "Context Word Count",
      "type": "integer"
    },
    "context_source_start_paragraph": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Source Start Paragraph"
    },
    "context_source_end_paragraph": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Source End Paragraph"
    },
    "translation_file": {
      "format": "path",
      "title": "Translation File",
      "type": "string"
    },
    "translation_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Translation Sha256"
    },
    "source_word_count": {
      "minimum": 0,
      "title": "Source Word Count",
      "type": "integer"
    },
    "translation_word_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Translation Word Count"
    },
    "source_paragraph_count": {
      "minimum": 0,
      "title": "Source Paragraph Count",
      "type": "integer"
    },
    "translation_paragraph_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Translation Paragraph Count"
    },
    "status": {
      "$ref": "#/$defs/ChunkStatus"
    },
    "translation_attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Translation Attempts",
      "type": "integer"
    },
    "review_attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Review Attempts",
      "type": "integer"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "glossary_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Glossary Version"
    },
    "chunk_engine_version": {
      "default": "",
      "title": "Chunk Engine Version",
      "type": "string"
    },
    "cleaned_source_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cleaned Source Sha256"
    },
    "oversize": {
      "default": false,
      "title": "Oversize",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "chunk_id",
    "chapter_id",
    "sequence",
    "source_file",
    "source_sha256",
    "context_file",
    "translation_file",
    "source_word_count",
    "source_paragraph_count",
    "status",
    "created_at",
    "updated_at"
  ],
  "title": "ChunkMetadata",
  "type": "object"
}
